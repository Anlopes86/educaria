rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(teacherId) {
      return signedIn() && request.auth.uid == teacherId
        && betaAccess(teacherId)
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(teacherId));
    }

    function betaAccess(teacherId) {
      return !exists(/databases/$(database)/documents/platformControl/betaEnrollment)
        || get(/databases/$(database)/documents/platformControl/betaEnrollment).data.enabled != true
        || (exists(/databases/$(database)/documents/betaEnrollments/$(teacherId))
          && get(/databases/$(database)/documents/betaEnrollments/$(teacherId)).data.status == 'approved');
    }

    function validNewTeacher() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.role == "teacher"
        && request.resource.data.plan == "free";
    }

    function protectedTeacherFieldsUnchanged() {
      // Legacy profiles omitted these fields. Permit their safe defaults without
      // letting the browser assign itself an elevated role or paid plan.
      return request.resource.data.get('role', 'teacher') == resource.data.get('role', 'teacher')
        && request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free');
    }

    match /teachers/{teacherId} {
      allow create: if isOwner(teacherId) && validNewTeacher();
      allow read, delete: if isOwner(teacherId);
      allow update: if isOwner(teacherId) && protectedTeacherFieldsUnchanged();

      match /classes/{classId} {
        allow read, write: if isOwner(teacherId);

        match /materials/{materialId} {
          allow read, write: if isOwner(teacherId);
        }
      }

      match /lessons/{lessonId} {
        allow read, write: if isOwner(teacherId);
      }

      match /platform/{documentId} {
        allow read, write: if isOwner(teacherId);
      }

      match /productAnalyticsEvents/{eventId} {
        allow read, write: if isOwner(teacherId);
      }
    }

    match /templates/{templateId} {
      allow read: if signedIn() && betaAccess(request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
