rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(teacherId) {
      return signedIn() && request.auth.uid == teacherId
        && betaAccess(teacherId);
    }

    function betaAccess(teacherId) {
      // At most two distinct Firestore documents in each branch. The server
      // atomically mirrors deletion locks in betaEnrollments before cleanup.
      return !firestore.exists(/databases/(default)/documents/platformControl/betaEnrollment)
        || firestore.get(/databases/(default)/documents/platformControl/betaEnrollment).data.enabled != true
        ? !firestore.exists(/databases/(default)/documents/accountDeletionJobs/$(teacherId))
        : (firestore.exists(/databases/(default)/documents/betaEnrollments/$(teacherId))
          && firestore.get(/databases/(default)/documents/betaEnrollments/$(teacherId)).data.status == 'approved'
          && firestore.get(/databases/(default)/documents/betaEnrollments/$(teacherId)).data.get('accessBlocked', false) == false);
    }

    function allowedTeacherUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|text/plain|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/rtf|text/rtf');
    }

    match /teachers/{teacherId}/{allPaths=**} {
      allow read: if isOwner(teacherId);
      allow create, update: if isOwner(teacherId) && allowedTeacherUpload();
      allow delete: if isOwner(teacherId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
